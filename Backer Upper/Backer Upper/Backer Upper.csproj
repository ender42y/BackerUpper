<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the project build (not run) on non-Windows machines, e.g. CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Backer_Upper</RootNamespace>
    <AssemblyName>Backer Upper</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackerUpper.Core\BackerUpper.Core.csproj" />
  </ItemGroup>

</Project>
