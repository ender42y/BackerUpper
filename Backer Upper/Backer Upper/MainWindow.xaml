<Window x:Class="Backer_Upper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Backer_Upper.Views"
        Title="Backer Upper" Width="720" Height="600" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar"/>
    </Window.TaskbarItemInfo>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Folder to back up" FontSize="16" FontWeight="SemiBold"/>
        <views:FilePicker Grid.Row="1" x:Name="SourcePicker" DialogTitle="Select the folder to back up" Margin="0,6,0,16"/>

        <TextBlock Grid.Row="2" Text="Where to put the backup" FontSize="16" FontWeight="SemiBold"/>
        <views:FilePicker Grid.Row="3" x:Name="TargetPicker" DialogTitle="Select where to put the backup" Margin="0,6,0,16"/>

        <GroupBox Grid.Row="4" x:Name="ModeGroup" Header="When a file is already in the backup" Padding="8,4">
            <StackPanel>
                <RadioButton x:Name="UpdateBtn" GroupName="Mode" IsChecked="True" Margin="0,4">
                    <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Copy new and replace changed"/>
                        <LineBreak/>
                        <Run Foreground="Gray" Text="Adds missing files and updates ones that changed since the last backup."/>
                    </TextBlock>
                </RadioButton>
                <RadioButton x:Name="ReplaceBtn" GroupName="Mode" Margin="0,4">
                    <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Copy and replace all"/>
                        <LineBreak/>
                        <Run Foreground="Gray" Text="Copies every file, overwriting what's in the backup. Slowest."/>
                    </TextBlock>
                </RadioButton>
                <RadioButton x:Name="NewBtn" GroupName="Mode" Margin="0,4">
                    <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Copy new only"/>
                        <LineBreak/>
                        <Run Foreground="Gray" Text="Adds missing files and never changes anything already in the backup."/>
                    </TextBlock>
                </RadioButton>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="5" Margin="0,20,0,0">
            <ProgressBar x:Name="Progress" Height="18" Maximum="1"/>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14"/>
            <TextBlock x:Name="DetailText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="Gray"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ReportBtn" Content="Open error report" Padding="16,8" Margin="0,0,10,0"
                    Visibility="Collapsed" Click="ReportBtn_Click"/>
            <Button x:Name="StartBtn" Content="Start backup" Padding="24,8" MinWidth="140" FontSize="14"
                    IsDefault="True" Click="StartBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
